{
  "name": "dsh-claim-check",
  "version": "0.1.0",
  "description": "DSH plugin: path-level protection, attempt logging and judgment budget for the claim-check skill.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "author": "Ashley Lin <44889191+Tonited@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tonited/claim-check.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "claim-check",
    "evidence",
    "reward-hacking",
    "verification"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit && node build.mjs && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2"
  }
}
